\newcommand{\dateorinvalid}[3]{ % month, year, error (1 | 0)
    \IfInteger{#2}{
        \DTMsavenow{now}
        \ifnum\number#2<\DTMfetchyear{now}
            \ifnum#3=1\PackageError{Thesis}{Invalid year "#2". You can't publish a thesis in the past! The year must be at least \DTMfetchyear{now}}{}\else\fi
            {\color{red}\textbf{\textsc{Error:} Invalid Date}} 
        \else
            \IfStrEqCase{#1}{
                {\ifpt{Janeiro}{January}}{#1, #2}
                {\ifpt{Fevereiro}{February}}{#1, #2}
                {\ifpt{Mar\c{c}o}{March}}{#1, #2}
                {\ifpt{Abril}{April}}{#1, #2}
                {\ifpt{Maio}{May}}{#1, #2}
                {\ifpt{Junho}{June}}{#1, #2}
                {\ifpt{Julho}{July}}{#1, #2}
                {\ifpt{Agosto}{August}}{#1, #2}
                {\ifpt{Setembro}{September}}{#1, #2}
                {\ifpt{Outubro}{October}}{#1, #2}
                {\ifpt{Novembro}{November}}{#1, #2}
                {\ifpt{Dezembro}{December}}{#1, #2}}
                [
                    \ifnum#3=1\ifpt{
                        \PackageError{Thesis}{Invalid month "#1". Should be one of: Janeiro, Fevereiro, Março, Abril, Maio, Junho, Julho, Agosto, Setembro, Outubro, Novembro, Dezembro (case-sensitive)}{}
                    }{
                        \PackageError{Thesis}{Invalid month "#1". Should be one of: January, February, March, April, May, June, July, August, September, October, November, December (case-sensitive)}{}
                    }\else\fi
                    {\color{red}\textbf{\textsc{Error:} Invalid Date}}
                ]
        \fi
    }{
        \ifnum#3=1\PackageError{Thesis}{Year "#2" is not an integer}{}\else\fi
        {\color{red}\textbf{\textsc{Error:} Invalid Date}}
    }
}

